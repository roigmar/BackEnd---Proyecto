extends layout-portal

block nav-extra
  a(href="/admin") ← Volver al panel
  span.nav-badge Administrador
  a(href="/admin/logout" style="color:var(--text-muted); font-size:0.85rem;") Cerrar sesión

block content
  .card(style="max-width: 900px; width: 100%;")
    .card-header(style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;")
      h2.section-title(style="margin:0;") Catálogo de Productos
      a(href="/admin/productos/nuevo").btn.btn-secondary(style="padding:0.45rem 1rem; font-size:0.85rem;") ＋ Nuevo producto
    p.section-sub(style="margin-bottom: 1.5rem;") Listado completo de productos disponibles.

    // Buscador de productos (filtra por nombre)
    .search-container
      form.search-form(method="GET" action="/admin/productos")
        .search-input-wrapper          
          input.search-input(type="search" name="q" placeholder="Buscar por nombre..." value=(q || ''))
          button.search-icon(type="submit") 🔍
              // script para recargar catálogo cuando se limpia el input (botón X nativo)
              script.
                (function(){
                  const input = document.querySelector('.search-input');
                  if (!input) return;
                  const reloadFull = () => { window.location = '/admin/productos'; };
                  input.addEventListener('search', function(){ if (this.value === '') reloadFull(); });
                  let prev = input.value;
                  input.addEventListener('input', function(){ if (this.value === '' && prev !== '') reloadFull(); prev = this.value; });
                })();

    if error
      .alert.alert-error
        span ⚠️
        span= error

    if msg
      .alert.alert-success.alert-dismissible
        span ✅
        if msg == 'creado'
          span Producto creado correctamente.
        else if msg == 'actualizado'
          span Producto actualizado correctamente.
        else
          span Operación realizada correctamente.
      script.
        setTimeout(() => {
          const alert = document.querySelector('.alert-dismissible');
          if (alert) alert.style.display = 'none';
        }, 3000);

    if !productos || productos.length === 0
      p(style="color: var(--text-muted); text-align:center; padding: 2rem;") No hay productos cargados.
    else
      table.portal-table
        thead
          tr
            th Nombre
            th Precio
            th Descripción
            th Stock
            th Acciones
        tbody
          each producto in productos
            tr
              td= producto.nombre
              td $#{producto.precio.toLocaleString('es-AR')}
              td= producto.descripcion
              td= producto.stock
              td.actions-column
                a.btn.action-btn.btn-edit(href='/admin/productos/' + producto._id + '/editar' title="Editar producto")
                  span.icon ✏️
