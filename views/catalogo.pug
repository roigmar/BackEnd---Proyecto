extends layout-portal

block nav-extra
  a(href="/admin") ← Volver al panel
  span.nav-badge Administrador
  a(href="/admin/logout" style="color:var(--text-muted); font-size:0.85rem;") Cerrar sesión

block content
  .card(style="max-width: 900px; width: 100%;")
    .card-header(style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.25rem;")
      h2.section-title(style="margin:0;") Catálogo de Productos
      a(href="/admin/productos/nuevo").btn.btn-secondary(style="padding:0.45rem 1rem; font-size:0.85rem;") ＋ Nuevo producto
    p.section-sub(style="margin-bottom: 1.5rem;") Listado completo de productos disponibles.

    if error
      .alert.alert-error
        span ⚠️
        span= error

    if !productos || productos.length === 0
      p(style="color: var(--text-muted); text-align:center; padding: 2rem;") No hay productos cargados.
    else
      table.portal-table
        thead
          tr
            th Nombre
            th Precio
            th Descripción
            th Stock
        tbody
          each producto in productos
            tr
              td= producto.nombre
              td $#{producto.precio.toLocaleString('es-AR')}
              td= producto.descripcion
              td= producto.stock
