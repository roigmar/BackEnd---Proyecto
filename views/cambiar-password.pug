extends layout-portal

block content
  .card(style="max-width: 520px; width: 100%;")
    h2.section-title Cambiar contraseña
    p.section-sub Ingresá tu nueva contraseña abajo

    if error
      .alert.alert-error
        span ⚠️
        span= error

    form(action="/portal/cambiar-password" method="POST")
      .form-group
        label(for='password') Nueva contraseña
        input#password(type="password" name="password" required)

      .form-group
        label(for='confirmarPassword') Repetir contraseña
        input#confirmarPassword(type="password" name="confirmarPassword" required)

      button.btn.btn-primary(type="submit")
        span Cambiar contraseña