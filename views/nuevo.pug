extends layout-portal

block nav-extra
  a(href="/admin/productos") ← Volver al catálogo
  span.nav-badge Administrador
  a(href="/admin/logout" style="color:var(--text-muted); font-size:0.85rem;") Cerrar sesión

block content
  .card(style="max-width: 520px; width: 100%;")
    if producto
      h2.section-title Editar Producto
      p.section-sub Modificá los datos del producto.
    else
      h2.section-title Nuevo Producto
      p.section-sub Completá los datos para agregar un producto al catálogo.

    if error
      .alert.alert-error
        span ⚠️
        span= error

    - var formAction = producto ? '/admin/productos/' + producto._id + '/editar' : '/admin/productos/nuevo'
    form(action=formAction method='POST')
      .form-group
        label(for='nombre') Nombre
        input#nombre(
          type='text'
          name='nombre'
          placeholder='Ej: Pan de molde'
          required
          value=(producto ? producto.nombre : '')
        )

      .form-group
        label(for='precio') Precio ($)
        input#precio(
          type='number'
          name='precio'
          min='0'
          step='1'
          placeholder='Ej: 1500'
          required
          value=(producto ? producto.precio : '')
        )

      .form-group
        label(for='descripcion') Descripción
        textarea#descripcion(
          name='descripcion'
          placeholder='Breve descripción del producto'
          required
        )= (producto ? producto.descripcion : '')

      .form-group
        label(for='stock') Stock inicial
        input#stock(
          type='number'
          name='stock'
          min='0'
          step='1'
          placeholder='Ej: 50'
          required
          value=(producto ? producto.stock : '')
        )

      button.btn.btn-primary(type='submit')
        span Guardar producto
