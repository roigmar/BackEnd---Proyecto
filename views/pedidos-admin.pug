extends layout-portal

block nav-extra
  a(href="/admin") ← Volver al panel
  span.nav-badge Administrador
  a(href="/admin/logout" style="color:var(--text-muted); font-size:0.85rem;") Cerrar sesión


block content
  .card(style="max-width: 1000px; width: 100%;")
    h2.section-title Pedidos
    p.section-sub(style="margin-bottom: 1.5rem;") Pedidos cargados por sucursales y franquicias.

    //- ── Filtros: estado + cliente ──
    form(method="GET" action="/admin/pedidos" style="display:flex; gap:0.75rem; align-items:center; margin-bottom:1.5rem; flex-wrap:wrap;")
      span(style="font-size:0.82rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;") Filtrar por estado:
      select(name="estado" onchange="this.form.submit()" style="background:var(--bg-input); border:1px solid var(--border); color:var(--text-main); border-radius:6px; padding:0.45rem 0.75rem; font-size:0.9rem;")
        option(value="" selected=(estadoFiltro === '')) Todos
        option(value="pendiente"      selected=(estadoFiltro === 'pendiente'))      Pendiente
        option(value="en producción"  selected=(estadoFiltro === 'en producción'))  En producción
        option(value="despachado"     selected=(estadoFiltro === 'despachado'))     Despachado
        option(value="entregado"      selected=(estadoFiltro === 'entregado'))      Entregado

      //- Filtro por cliente debajo
      if clientes && clientes.length
        span(style="font-size:0.82rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.08em;") Filtrar por cliente:
        select(name="cliente" onchange="this.form.submit()" style="background:var(--bg-input); border:1px solid var(--border); color:var(--text-main); border-radius:6px; padding:0.45rem 0.75rem; font-size:0.9rem;")
          option(value="" selected=(clienteFiltro === '')) Todos
          each c in clientes
            option(value=c._id selected=(clienteFiltro == c._id))= c.nombre

    if error
      .alert.alert-error
        span ⚠️
        span= error

    if !pedidos || pedidos.length === 0
      p(style="color:var(--text-muted); text-align:center; padding:2.5rem;") No hay pedidos para mostrar.
    else
      //- ── Tabla de pedidos ──
      table.portal-table
        thead
          tr
            th Fecha
            th Cliente
            th Tipo
            th Productos
            th Total
            th Estado
        tbody
          each pedido in pedidos
            tr
              td= new Date(pedido.fecha).toLocaleDateString('es-AR', { day:'2-digit', month:'2-digit', year:'numeric' })
              td= pedido.clienteId ? pedido.clienteId.nombre : '—'
              td
                if pedido.clienteId && pedido.clienteId.tipo === 'FRANQUICIA'
                  span.estado-badge.tipo-franquicia Franquicia
                else
                  span.estado-badge.tipo-sucursal Sucursal
              td
                //- Lista compacta de productos del pedido
                ul(style="margin:0; padding-left:1rem; font-size:0.82rem; color:var(--text-muted);")
                  each detalle in pedido.detalles
                    li
                      | #{detalle.productoId ? detalle.productoId.nombre : 'Producto eliminado'}
                      span(style="color:var(--gold-dark);")  ×#{detalle.cantidad}
              td $#{pedido.total.toLocaleString('es-AR')}
              td.status-cell
                - var transiciones = { 'pendiente': 'en producción', 'en producción': 'despachado', 'despachado': 'entregado' }
                - var siguiente = transiciones[pedido.estado]
                .status-dropdown(data-id=pedido._id)
                  button.status-toggle(type='button' aria-expanded='false')
                    span.estado-badge(class='estado-' + pedido.estado.replace(' ', '-'))= pedido.estado
                    if siguiente
                      span.caret ▾
                  if siguiente
                    .status-menu(role='menu' aria-hidden='true')
                      button.status-action(type='button' role='menuitem' data-next=siguiente)= 'Pasar a: ' + siguiente

      // script para manejar dropdown en la celda de estado y actualizar vía fetch PATCH sin recargar la página
      script.
        (function(){
          async function cambiarEstado(id, nuevoEstado){
            try{
              const res = await fetch('/pedidos/' + id + '/estado', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ estado: nuevoEstado })
              });
              if (!res.ok) {
                const err = await res.json().catch(()=>({ error: 'Error' }));
                alert(err.error || 'Error al actualizar estado');
                return null;
              }
              return await res.json();
            } catch(e){
              alert('Error de red al actualizar estado');
              return null;
            }
          }

          document.addEventListener('click', async function(e){
            const toggle = e.target.closest && e.target.closest('.status-toggle');
            if (toggle){
              const dropdown = toggle.parentElement;
              const menu = dropdown.querySelector('.status-menu');
              const expanded = toggle.getAttribute('aria-expanded') === 'true';
              // cerrar otros abiertos
              document.querySelectorAll('.status-dropdown .status-toggle[aria-expanded="true"]').forEach(el=>{ el.setAttribute('aria-expanded','false'); el.parentElement.querySelector('.status-menu').setAttribute('aria-hidden','true'); });
              if (!expanded && menu){ toggle.setAttribute('aria-expanded','true'); menu.setAttribute('aria-hidden','false'); }
              else if (menu){ toggle.setAttribute('aria-expanded','false'); menu.setAttribute('aria-hidden','true'); }
              return;
            }

            const action = e.target.closest && e.target.closest('.status-action');
            if (action){
              const menu = action.closest('.status-menu');
              const dropdown = action.closest('.status-dropdown');
              const id = dropdown && dropdown.getAttribute('data-id');
              const next = action.getAttribute('data-next');
              if (!id || !next) return;
              if (!confirm('Confirmar cambio de estado a: ' + next + '?')) return;
              const result = await cambiarEstado(id, next);
              if (result){
                // actualizar badge en la celda sin recargar
                const badge = dropdown.querySelector('.estado-badge');
                if (badge) badge.textContent = result.estado;
                // cerrar menu
                const toggleBtn = dropdown.querySelector('.status-toggle');
                if (toggleBtn) toggleBtn.setAttribute('aria-expanded','false');
                if (menu) menu.setAttribute('aria-hidden','true');
                // actualizar clase del badge para estilos
                if (badge){ badge.className = 'estado-badge estado-' + result.estado.replace(/\s+/g,'-'); }
              }
              return;
            }

            // clic fuera cierra menús
            if (!e.target.closest || !e.target.closest('.status-dropdown')){
              document.querySelectorAll('.status-dropdown .status-toggle[aria-expanded="true"]').forEach(el=>{ el.setAttribute('aria-expanded','false'); el.parentElement.querySelector('.status-menu').setAttribute('aria-hidden','true'); });
            }
          });
        })();

